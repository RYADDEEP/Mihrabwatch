         _short used by Complication SHORT_TEXT title; _long used by Tile bottom line and Complication LONG_TEXT title. -->
    <string name="watch_countdown_short_hm">%1$dh %2$dm</string>
    <string name="watch_countdown_short_m">%1$dm</string>
