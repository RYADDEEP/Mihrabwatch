    <!-- App + Tile + Complication countdown formatter. %1$d = hours, %2$d = minutes.
         _hm used when hours >= 1; _m when only minutes remain.
         THERE IS NO LEADING WORD, AND NO _long PAIR ANY MORE. The countdown used to read
         "in 1h 45m", and every locale carried its own prefix or suffix for that "in" —
         which is small in English and long everywhere else, on a surface with no width to
         spare. countdownLong() now delegates to countdownShort(), so all three surfaces
         read these two strings and cannot drift apart. -->
    <string name="watch_countdown_short_hm">%1$dh %2$dm</string>
    <string name="watch_countdown_short_m">%1$dm</string>
